{
  "name": "dsh-deepseek-chat",
  "version": "1.0.0",
  "description": "在 DSH 左侧边栏加一个原生菜单项「DeepSeek chat」：点它在独立浏览器窗口里打开 chat.deepseek.com（登录态持久化，窗口已存在时切回前台）；支持双向划词互传（DSH 划词一键传给网页端输入框 / 网页端划词浮现气泡一键接力回 DSH 输入框）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "sidebar",
    "chat"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "page-script.js",
    "cordis.patch.yml",
    "install.ps1",
    "uninstall.ps1",
    "tools",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": false
    }
  }
}
